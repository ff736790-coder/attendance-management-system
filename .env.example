# Server Configuration
PORT=5000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=super_secure_jwt_secret_key_attendance_system_2026_ams_college
JWT_EXPIRES_IN=7d

# Database Configuration (Aiven Cloud MySQL or Local MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=attendance_db
DB_CONNECTION_LIMIT=10

# Aiven Cloud MySQL SSL Settings
# Set DB_SSL=true when using Aiven Cloud MySQL
DB_SSL=false
# Optional: path to Aiven CA certificate (e.g., ./ca.pem)
DB_SSL_CA_PATH=
DB_SSL_REJECT_UNAUTHORIZED=true

# AI Provider Configuration (OpenAI compatible API)
# Leave empty to utilize high-precision rule-based AI fallback automatically
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
CORS_ORIGIN=*
